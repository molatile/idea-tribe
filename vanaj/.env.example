# Gemini API Key for Tribal Language Translation
# Kept securely on the server side (never exposed to client browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Public Configuration (Feedback System)
# Client-accessible variables for community reviews & ratings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# EmailJS Configuration (Automatic Order & Purchase Receipt System)
# 1. Sign up at https://www.emailjs.com/
# 2. Get Service ID from "Email Services" tab
# 3. Get Public Key from "Account" tab
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Template 1: For the Store Owner / You (Full Order Notification with delivery address & customer phone)
VITE_EMAILJS_ADMIN_TEMPLATE_ID=template_admin_xxxx

# Template 2: For the Client / Buyer (Purchase Confirmation & Itemized Receipt)
VITE_EMAILJS_BUYER_TEMPLATE_ID=template_buyer_xxxx

# Specific email address where YOU want to receive all incoming purchase orders
VITE_EMAILJS_RECEIPT_EMAIL=your_email@gmail.com
